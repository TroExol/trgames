# Ключ OpenRouter для генерации lucid (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Модель OpenRouter. Пусто — deepseek/deepseek-v4.1-flash:nitro
# LUCID_MODEL=

# Файл базы lucid относительно server/. По умолчанию lucid.db
# LUCID_DB_PATH=lucid.db

# Разрешённый CORS origin, например https://example.com. Пусто — любой
# CORS_ORIGIN=
